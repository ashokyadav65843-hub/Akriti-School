          </a>
</div>
</div>
</div>
</div>
</div>
<script>
  function handleInquirySubmit(event) {
    event.preventDefault();
    const form = document.getElementById('admission-inquiry-form');
    const successBanner = document.getElementById('form-success-banner');
    form.classList.add('opacity-50', 'pointer-events-none');
    successBanner.classList.remove('hidden');
    form.reset();
  }

  function filterGallery(category) {
    const tabs = document.querySelectorAll('.gallery-tab');
    tabs.forEach(tab => {
      tab.classList.remove('bg-primary', 'text-on-primary');
      tab.classList.add('bg-surface-container-lowest', 'text-on-surface');
    });
    event.target.classList.remove('bg-surface-container-lowest', 'text-on-surface');
    event.target.classList.add('bg-primary', 'text-on-primary');

    const items = document.querySelectorAll('.gallery-item');
    items.forEach(item => {
      if (category === 'all' || item.classList.contains(category)) {
        item.style.display = 'block';
      } else {
        item.style.display = 'none';
      }
    });
  }
</script></main><footer class="w-full bg-primary-container text-on-primary mt-space-4xl"><div class="h-1 bg-secondary-container w-full"></div><div class="max-w-max-width-content mx-auto px-gutter-desktop py-space-3xl"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-space-2xl"><div class="lg:col-span-2 space-y-space-md"><div class="flex items-center gap-space-sm"><img alt="The Heritage Academy Crest Logo" class="h-8 w-auto object-contain brightness-200" src="https://lh3.googleusercontent.com/aida/AEtjO1V_s28gM823ph1-WepDku9jci1TVuLToTHMppcJIozKjN4oh4JxBzJXC2j6u1ofrBxMpNwOVZ1OB-tI2KIM-aFWtoJv8wNIFm07m1HxkFribBUuVTfnBLpOSif6EufrusfIEo_iGKo2XlB-kwZCxrZnrlWsuc2KWoxcpz53rcB3lgGuHz3sBoSxb2LrxKgrlYAEcabmWakekBoOtZyiEh5uQoFueVCenV5qnrYUfMBvvCUEg9uB1eFt3pw_"/><span class="font-headline-md text-headline-md text-on-primary font-bold">The Heritage Academy</span></div><p class="font-body-md text-body-md text-surface-dim max-w-md">Nurturing intellectual curiosity, scholarly character, and global leadership within a heritage-rich collegiate environment. Fully accredited by the Central Board of Secondary Education (CBSE), New Delhi.</p><div class="pt-space-xs font-body-sm text-body-sm text-tertiary-fixed-dim space-y-space-2xs"><p class="flex items-center gap-space-xs">Sector B, Pocket 8, Institutional Area, Vasant Kunj, New Delhi - 110070</p><p class="flex items-center gap-space-xs">Emergency Helplines: +91 (011) 2894-3299 / 3298</p><p class="flex items-center gap-space-xs">Affiliation Code: 1930482 | School Code: 40182</p></div></div><div class="space-y-space-sm"><h3 class="font-headline-sm text-headline-sm text-secondary-fixed">Academics</h3><ul class="space-y-space-xs font-body-sm text-body-sm text-surface-dim"><li><a class="hover:text-on-primary transition-colors" data-path="academics" href="#">Curriculum Overview</a></li><li><a class="hover:text-on-primary transition-colors" data-path="primary-school" href="#">Primary Wing (I - V)</a></li><li><a class="hover:text