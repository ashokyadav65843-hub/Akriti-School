<div class="absolute bottom-6 left-6 right-6 text-on-primary">
<span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary-container">Academic Leadership</span>
<h3 class="font-headline-lg text-headline-lg font-bold">Dr. Meena Sharma</h3>
<p class="font-body-sm text-body-sm text-primary-fixed mt-1">Ph.D. in Education (Delhi University) • National Awardee for Educational Leadership</p>
</div>
</div>
<!-- Principal Address -->
<div class="lg:col-span-7 p-space-xl lg:p-space-2xl flex flex-col justify-between">
<div class="space-y-space-md">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest font-bold">Principal's Desk</span>
<span class="material-symbols-outlined text-secondary-container text-4xl">format_quote</span>
